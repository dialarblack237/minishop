# .env.example — SHAPE, not VALUES.
# Every real value lives in the hosting dashboard (Render / GitHub Environments).
# Copy this file to .env locally if you want, then fill the values from the dashboard.
# .env is in .gitignore; this file is committed on purpose so the next developer knows
# which environment variables the app expects.

DATABASE_URL=jdbc:postgresql://HOST:5432/minishop
DATABASE_USER=REPLACE_ME
DATABASE_PASSWORD=REPLACE_ME

REDIS_URL=redis://HOST:6379

KAFKA_BOOTSTRAP_SERVERS=HOST:9092
KAFKA_SASL_USER=REPLACE_ME
KAFKA_SASL_PASSWORD=REPLACE_ME

JWT_SIGNING_KEY=REPLACE_ME